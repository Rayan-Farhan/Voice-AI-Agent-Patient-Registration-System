# Local development uses SQLite; production sets a Neon Postgres URL.
DATABASE_URL=sqlite:///./patients.db

# Shared secret the Vapi assistant sends on every tool call.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SHARED_SECRET=change-me

# Optional: only needed if the assistant is pointed at a self-hosted LLM
# instead of Vapi's bundled model. LLM_PROVIDER is one of: vapi | gemini | groq
LLM_PROVIDER=vapi
GEMINI_API_KEY=
GROQ_API_KEY=
